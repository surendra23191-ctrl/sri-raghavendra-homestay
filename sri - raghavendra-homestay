            event.preventDefault();

            const name = document.getElementById('name').value;
            const phone = document.getElementById('phone').value;
            const roomType = document.getElementById('roomType').value;
            const checkin = document.getElementById('checkin').value || 'Not specified';
            const message = document.getElementById('message').value || 'None';

            const successBox = document.getElementById('formSuccess');
            successBox.classList.remove('hidden');

            const text = `Hello Sri Raghavendra Home Stay,%0A%0A` +
                         `*New Booking Inquiry:*%0A` +
                         `• *Name:* ${encodeURIComponent(name)}%0A` +
                         `• *Phone:* ${encodeURIComponent(phone)}%0A` +
                         `• *Room:* ${encodeURIComponent(roomType)}%0A` +
                         `• *Check-in Date:* ${encodeURIComponent(checkin)}%0A` +
                         `• *Details:* ${encodeURIComponent(message)}`;

            setTimeout(() => {
                window.open(`https://wa.me/919989606123?text=${text}`, '_blank');
                document.getElementById('inquiryForm').reset();
                successBox.classList.add('hidden');
            }, 1200);
